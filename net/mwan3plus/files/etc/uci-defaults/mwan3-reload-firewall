#!/bin/sh

set_firewall_option()
{
	[ "$(uci -q get "firewall.$1")" = "$2" ] && return 0
	uci -q set "firewall.$1=$2"
}

delete_firewall_option()
{
	uci -q get "firewall.$1" >/dev/null || return 0
	uci -q delete "firewall.$1"
}

delete_firewall_option mwan3_ipv6_masq || exit 1
set_firewall_option mwan3 include || exit 1
set_firewall_option mwan3.type script || exit 1
set_firewall_option mwan3.path /usr/share/mwan3/mwan3-reload.sh || exit 1
set_firewall_option mwan3.enabled 1 || exit 1
# fw4 runs script includes on start/reload; the callback checks our own tables.
# Its deprecated reload option cannot suppress callbacks and causes a warning.
if command -v fw4 >/dev/null 2>&1; then
	set_firewall_option mwan3.fw4_compatible 1 || exit 1
	delete_firewall_option mwan3.reload || exit 1
else
	# fw3 reload preserves our mangle chains and NAT66 helper rules.
	set_firewall_option mwan3.reload 0 || exit 1
	delete_firewall_option mwan3.fw4_compatible || exit 1
fi

# Include pending owner changes left by a failed commit, so retries can finish.
firewall_changes=$(uci -q changes firewall) || exit 1
if printf '%s\n' "$firewall_changes" | grep -qE '^-?firewall\.(mwan3([.=]|$)|mwan3_ipv6_masq([.=]|$))'; then
	uci -q commit firewall || exit 1
fi

exit 0
