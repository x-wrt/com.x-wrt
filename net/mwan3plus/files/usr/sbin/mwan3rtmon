#!/bin/sh

. /lib/functions.sh
. /lib/functions/network.sh
. /lib/mwan3/common.sh
. /lib/mwan3/mwan3.sh

mwan3_rtmon_route_handle()
{
	local action route_line route_family family tbl route tid id word last_word from dev
	route_line=${1##"Deleted "}
	route_family=$2

	if [ "$route_family" = "ipv4" ]; then
		IP="$IP4"
	elif [ "$route_family" = "ipv6" ] && [ $NO_IPV6 -eq 0 ]; then
		IP="$IP6"
	else
		return
	fi

	if [ "$route_line" == "$1" ]; then
		action="add"
	else
		action="del"
	fi

	[ "$route_family" = "ipv6" ] &&
	if [ -z "${route_line##default from*}" ] || [ -z "${route_line##::/0 from*}" ]; then
		from=
		dev=
		last_word=
		for word in $route_line; do
			case "$last_word" in
				from) from=$word ;;
				dev) dev=$word ;;
			esac
			last_word=$word
		done
		if [ -n "$from" ] && [ -n "$dev" ]; then
			handle_ipv6_default_iface()
			{
				local enabled family iface_device iface_id true_iface

				mwan3_get_iface_id iface_id "$1"
				[ -n "$iface_id" ] || return
				config_get enabled "$1" enabled 0
				config_get family "$1" family "any"
				[ "$enabled" = "1" ] || return
				[ "$family" = "ipv6" ] || [ "$family" = "any" ] || return
				mwan3_get_true_iface true_iface "$1" ipv6
				network_is_up "$true_iface" || return
				network_get_device iface_device "$true_iface"
				[ "$iface_device" = "$dev" ] || return

				INTERFACE=$1 DEVICE=$dev ACTION=ifup mwan3_ipv6_masq_help
				LOG debug "call INTERFACE=$1 DEVICE=$dev ACTION=ifup mwan3_ipv6_masq_help by($action $route_line)"
			}
			config_foreach handle_ipv6_default_iface interface
		fi
		return
	fi

	# never add default route lines, since this is handled elsewhere
	[ -z "${route_line##default*}" ] && return
	[ -z "${route_line##::/0*}" ] && return
	[ -z "${route_line##fe80:*}" ] && return
	[ -z "${route_line##unreachable*}" ] && return
	mwan3_update_dev_to_table
	mwan3_route_line_dev "tid" "$route_line" "$route_family"
	handle_route() {
		tbl=$($IP route list table $id 2>/dev/null)
		if [ $action = "add" ]; then
			case "
$tbl" in
				*"
default"*|*"
::/0"*) ;;
				*) return ;;
			esac
		else
			[ -z "$tbl" ] && return
		fi
		mwan3_prepare_route route "$route_line" "$id" "$tid"
		[ "$action" = "add" ] && [ -z "${tbl##*$route*}" ] && return
		[ "$action" = "del" ] && [ -n "${tbl##*$route*}" ] && return

		# Replace only this table's route. An add failure must never delete
		# matching routes from other tables before this table can be rebuilt.
		if [ "$action" = "add" ]; then
			$IP route replace table "$id" $route ||
				LOG warn "failed to replace $route in table $id"
		else
			$IP route del table "$id" $route ||
				LOG warn "failed to delete $route from table $id"
		fi
	}
	handle_route_cb(){
		let id++
		[ "$id" -gt "$MWAN3_INTERFACE_MAX" ] && return
		config_get family "$1" family "any"
		[ "$family" != "$route_family" ] && [ "$family" != "any" ] && return
		handle_route
	}

	id=0 config_foreach handle_route_cb interface

	mwan3_set_connected_${route_family}
}

mwan3_rtmon_update()
{
	local line=$1 family=$2 enabled flags

	case "$line" in
		"[LINK]Deleted "*) return 0 ;;
		"[LINK]"*)
			# Carrier recovery clears linkdown on existing main-table routes
			# without RTM_NEWROUTE. Recopy routes skipped during startup.
			flags=${line#*<}
			flags=${flags%%>*}
			case ",$flags," in *,UP,*) ;; *) return 0 ;; esac
			case ",$flags," in *,LOWER_UP,*) ;; *) return 0 ;; esac
			line=
		;;
		"[ROUTE]"*) line=${line#"[ROUTE]"} ;;
	esac

	# Hotplug flushes and rebuilds tables under this lock. Without it an
	# intervening LAN route event can be skipped while a table has no default.
	# BusyBox lock forks a persistent owner after acquiring the lock. A
	# blocking waiter orphaned by stop could acquire it later and deadlock
	# startup. Keep the wait in this shell so stop can terminate it safely.
	until mwan3_try_lock; do sleep 1; done
	config_load mwan3 || {
		mwan3_unlock "rtmon" "$family"
		return 1
	}
	config_get_bool enabled globals enabled 0
	if [ "$enabled" = 1 ]; then
		if [ -z "$line" ]; then
			mwan3_add_all_nondefault_routes "$family"
			mwan3_set_local_${family}
			mwan3_set_connected_${family}
		elif [ -z "${line##*local*table local*}" ]; then
			mwan3_set_local_${family}
		else
			mwan3_rtmon_route_handle "$line" "$family"
		fi
	fi
	mwan3_unlock "rtmon" "$family"
}

main()
{
	local IP family

	config_load mwan3
	family=$1
	[ -z $family ] && family=ipv4
	if [ "$family" = ipv6 ]; then
		IP="$IP6"
	else
		IP="$IP4"
	fi
	mwan3_init

	$IP monitor route link label | {
		# Reconcile the startup snapshot with the already running monitor.
		mwan3_rtmon_update "" "$family"
		while read -r line; do
			case "$line" in
				"[LINK]"*) ;;
				"[ROUTE]"*local*"table local"*) ;;
				"[ROUTE]"*" table "*) continue ;;
				"[ROUTE]"*) ;;
				*) continue ;;
			esac
			LOG debug "handling route update $family $line"
			mwan3_rtmon_update "$line" "$family"
		done
	}
}
main "$@"
