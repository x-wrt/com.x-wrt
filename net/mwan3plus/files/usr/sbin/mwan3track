#!/bin/sh

. /lib/functions.sh
. /lib/functions/network.sh
. /lib/mwan3/common.sh
. /lib/mwan3/mwan3.sh

INTERFACE=""
DEVICE=""
PING="/bin/ping"
FAMILY="any"

IFDOWN_EVENT=0
TRACK_DIR=""
DNS_QUERY_FILES=""

stop_subprocs() {
	local killpids

	killpids="$(jobs -p)"
	[ -n "$killpids" ] && kill $killpids 2>/dev/null
}

cleanup_dns_query_files() {
	local output_file

	for output_file in $DNS_QUERY_FILES; do
		rm -f "$output_file"
	done
	DNS_QUERY_FILES=""
}

clean_up() {
	LOG notice "Stopping mwan3track for interface \"${INTERFACE}\""
	IFDOWN_EVENT=2
	stop_subprocs
	cleanup_dns_query_files
	return 0
}

if_down() {
	LOG info "Detect ifdown event on interface ${INTERFACE} (${DEVICE})"
	IFDOWN_EVENT=1
	stop_subprocs
	cleanup_dns_query_files
}

validate_track_method() {
	local family method
	method="$1"
	family="$2"
	case "$method" in
		ping)
			if [ "$family" = "ipv4" ]; then
				/usr/bin/ping -4 -W1 -c1 -q 127.0.0.1 >/dev/null 2>&1 && PING="/usr/bin/ping -4" && return 0
				test -x /usr/bin/ping && PING="/usr/bin/ping" && return 0
				test -x /bin/ping && PING="/bin/ping -4" && return 0
			else
				/usr/bin/ping -6 -W1 -c1 -q ::1 >/dev/null 2>&1 && PING="/usr/bin/ping -6" && return 0
				test -x /usr/bin/ping6 && PING="/usr/bin/ping6" && return 0
				test -x /bin/ping && PING="/bin/ping -6" && return 0
			fi
			LOG warn "Missing ping. Please enable BUSYBOX_DEFAULT_PING and recompile busybox or install iputils-ping package."
			return 1
			;;
		arping)
			[ "$family" = "ipv6" ] && {
				LOG warn "arping does not support IPv6. Please use another track method."
				return 1
			}
			command -v arping 1>/dev/null 2>&1 || {
				LOG warn "Missing arping. Please install iputils-arping package."
				return 1
			}
			;;
		httping)
			command -v httping 1>/dev/null 2>&1 || {
				LOG warn "Missing httping. Please install httping package."
				return 1
			}
			;;
		nping-*)
			command -v nping 1>/dev/null 2>&1 || {
				LOG warn "Missing nping. Please install nping package."
				return 1
			}
			;;
		*)
			LOG warn "Unsupported tracking method: $track_method"
			return 2
			;;
	esac
}

validate_wrap() {
	[ -x /lib/mwan3/libwrap_mwan3_sockopt.so.1.0 ] && return 0
	LOG error "Missing libwrap_mwan3_sockopt. Please reinstall mwan3plus."
	return 1
}

disconnected() {
	local status

	readfile status "$TRACK_DIR/STATUS" || status="notracking"

	echo "offline" > "$TRACK_DIR/STATUS"
	get_uptime > "$TRACK_DIR/OFFLINE"
	echo "0" > "$TRACK_DIR/ONLINE"
	score=0
	[ "$1" = 1 ] && return

	# Only execute disconnectd action if status was online or disconnecting
	if [ "$status" = "online" ] || [ "$status" = "disconnecting" ]; then
		LOG notice "Interface $INTERFACE($FAMILY) ($DEVICE) is offline"
		env -i ACTION="disconnected" INTERFACE="$INTERFACE" DEVICE="$DEVICE" FAMILY="$FAMILY" /sbin/hotplug-call iface
	else
		LOG notice "Skip disconnected event for $INTERFACE($FAMILY) ($DEVICE)"
	fi
}

connected() {
	echo "online" > "$TRACK_DIR/STATUS"
	echo "0" > "$TRACK_DIR/OFFLINE"
	get_uptime > "$TRACK_DIR/ONLINE"
	host_up_count=0
	lost=0
	turn=0
	loss=0
	[ "$1" = 1 ] && return
	LOG notice "Interface $INTERFACE($FAMILY) ($DEVICE) is online"
	env -i ACTION="connected" INTERFACE="$INTERFACE" DEVICE="$DEVICE" FAMILY="$FAMILY" /sbin/hotplug-call iface
}

disconnecting() {
	echo "disconnecting" > "$TRACK_DIR/STATUS"
	LOG notice "Interface $INTERFACE($FAMILY) ($DEVICE) is disconnecting"
}

connecting() {
	echo "connecting" > "$TRACK_DIR/STATUS"
	LOG notice "Interface $INTERFACE($FAMILY) ($DEVICE) is connecting"
}

firstconnect() {
	if [ "$STATUS" = "offline" ]; then
		disconnected 1
	else
		connected 1
	fi
}

update_status() {
	local track_ip=$1

	echo "$2" > "$TRACK_DIR/TRACK_${track_ip}"
	[ -z "$3" ] && return
	echo "$3" > "$TRACK_DIR/LATENCY_${track_ip}"
	echo "$4" > "$TRACK_DIR/LOSS_${track_ip}"
}

get_default_gateway() {
	local _var family device route gateway

	_var="$1"
	family="$2"
	device="$3"
	if [ "$family" = "ipv4" ]; then
		route="$(ip -4 route show default dev "$device" 2>/dev/null)"
		gateway=255.255.255.255
	else
		route="$(ip -6 route show default dev "$device" 2>/dev/null)"
		gateway=ffff::
	fi

	case " $route " in
		*" via "*)
			route=${route#* via }
			gateway=${route%% *}
		;;
	esac

	export "$_var=$gateway"
}

main() {
	local reliability count timeout interval failure_interval
	local recovery_interval down up size
	local keep_failure_interval check_quality failure_latency
	local recovery_latency failure_loss recovery_loss
	local max_ttl httping_ssl

	[ -z "$5" ] && echo "Error: should not be started manually" && return 0

	family=$1
	INTERFACE=$2
	DEVICE=$3
	STATUS=$4
	FAMILY=$family
	TRACK_DIR="$MWAN3TRACK_STATUS_DIR/$INTERFACE.$family"
	mkdir -p "$TRACK_DIR"
	# DNS files are diagnostic state owned by this tracker process. Never reuse
	# files left by a previous process or an interrupted DNS query.
	rm -f "$TRACK_DIR"/DNS_CACHE_* "$TRACK_DIR"/DNS_OUTPUT.*
	trap clean_up TERM
	trap if_down USR1

	config_load mwan3
	mwan3_init
	config_get track_method $INTERFACE track_method ping
	config_get_bool httping_ssl $INTERFACE httping_ssl 0
	config_get reliability $INTERFACE reliability 1
	config_get count $INTERFACE count 1
	config_get timeout $INTERFACE timeout 4
	config_get interval $INTERFACE interval 10
	config_get down $INTERFACE down 5
	config_get up $INTERFACE up 5
	config_get size $INTERFACE size 56
	config_get max_ttl $INTERFACE max_ttl 60
	config_get failure_interval $INTERFACE failure_interval $interval
	config_get_bool keep_failure_interval $INTERFACE keep_failure_interval 0
	config_get recovery_interval $INTERFACE recovery_interval $interval
	config_get_bool check_quality $INTERFACE check_quality 0
	config_get failure_latency $INTERFACE failure_latency 1000
	config_get recovery_latency $INTERFACE recovery_latency 500
	config_get failure_loss $INTERFACE failure_loss 40
	config_get recovery_loss $INTERFACE recovery_loss 10

	local score=$((down+up))
	local host_up_count=0
	local lost=0
	local turn=0
	local sleep_time result ping_status ping_quality loss latency
	local current_track_ips gateway_ip gateway_resolved probe_targets probe_target
	local SRC_IP TRACK_OUTPUT
	local DNS_CACHE_TTL=120
	local DNS_RESOLVE_TIMEOUT=2
	local DNS_CACHE_RECORDS=""
	local DNS_UPSTREAMS=""
	local DNS_RESOLV_FILES=""
	local DNS_UPSTREAMS_AT=0
	local DNS_UPSTREAMS_VALID=0
	local DNS_QUERY_IPS=""
	shift 4
	local track_ips="$*"

	if [ "$family" = "ipv6" ]; then
		mwan3_get_src_ip6 SRC_IP "$INTERFACE"
	else
		mwan3_get_src_ip SRC_IP "$INTERFACE"
	fi
	validate_track_method "$track_method" "$family" || {
		LOG err "track method($track_method) src_ip($SRC_IP) invalid"
		return 1
	}
	if [ "$track_method" != "ping" ] && [ "$check_quality" -eq 1 ]; then
		LOG warn "check_quality is only supported with ping. Disabling quality checks for $track_method on interface $INTERFACE($family)."
		check_quality=0
	fi
	validate_wrap || return 1

	WRAP() {
		DEVICE=$DEVICE SRCIP=$SRC_IP FWMARK=$MMX_MASK \
			LD_PRELOAD=/lib/mwan3/libwrap_mwan3_sockopt.so.1.0 "$@"
	}

	add_dns_upstream() {
		local server
		server="$1"

		case "$server" in
			""|0.0.0.0|127.*|::|::1) return ;;
			*[!0-9A-Fa-f:.%]*) return ;;
		esac
		case "$server" in
			*.*|*:*) ;;
			*) return ;;
		esac
		case " $DNS_UPSTREAMS " in
			*" $server "*) ;;
			*) DNS_UPSTREAMS="${DNS_UPSTREAMS:+$DNS_UPSTREAMS }$server" ;;
		esac
	}

	add_dns_resolv_file() {
		local resolv_file
		resolv_file="$1"
		[ -n "$resolv_file" ] || return
		case " $DNS_RESOLV_FILES " in
			*" $resolv_file "*) ;;
			*) DNS_RESOLV_FILES="${DNS_RESOLV_FILES:+$DNS_RESOLV_FILES }$resolv_file" ;;
		esac
	}

	add_dnsmasq_server() {
		local value host port
		value="$1"

		# dnsmasq accepts /domain/server, server#port and server@interface.
		# BusyBox nslookup can query only numeric port-53 endpoints.
		value=${value##*/}
		[ -n "$value" ] || return
		value=${value%%@*}
		case "$value" in
			\[*\]#*)
				host=${value#\[}
				host=${host%%\]*}
				port=${value##*#}
			;;
			*#*)
				host=${value%#*}
				port=${value##*#}
			;;
			\[*\])
				host=${value#\[}
				host=${host%\]}
				port=53
			;;
			*)
				host=$value
				port=53
			;;
		esac
		[ "$port" = 53 ] || return
		add_dns_upstream "$host"
	}

	refresh_dns_upstreams() {
		local now age dns_servers server config_file line
		local resolv_file directive value remainder
		now="$1"

		if [ "$DNS_UPSTREAMS_VALID" -eq 1 ]; then
			age=$((now-DNS_UPSTREAMS_AT))
			[ "$age" -ge 0 ] && [ "$age" -lt "$DNS_CACHE_TTL" ] && return 0
		fi

		DNS_UPSTREAMS=""
		DNS_RESOLV_FILES=""
		network_get_dnsserver dns_servers "$INTERFACE"
		for server in $dns_servers; do
			add_dns_upstream "$server"
		done

		add_dns_resolv_file /tmp/resolv.conf.d/resolv.conf.auto
		resolv_file="$(uci -q get dhcp.@dnsmasq[0].resolvfile 2>/dev/null)"
		add_dns_resolv_file "$resolv_file"

		for config_file in /var/etc/dnsmasq.conf.*; do
			[ -r "$config_file" ] || continue
			while IFS= read -r line || [ -n "$line" ]; do
				case "$line" in
					resolv-file=*) add_dns_resolv_file "${line#resolv-file=}" ;;
					server=*) add_dnsmasq_server "${line#server=}" ;;
				esac
			done < "$config_file"
		done

		for resolv_file in $DNS_RESOLV_FILES; do
			[ -r "$resolv_file" ] || continue
			while read -r directive value remainder; do
				[ "$directive" = nameserver ] && add_dns_upstream "$value"
			done < "$resolv_file"
		done

		DNS_UPSTREAMS_AT=$now
		if [ -n "$DNS_UPSTREAMS" ]; then
			DNS_UPSTREAMS_VALID=1
		else
			# Do not cache an empty upstream set. The next actual domain probe
			# must rescan dnsmasq inputs so newly available DNS is used at once.
			DNS_UPSTREAMS_VALID=0
		fi
	}

	add_dns_query_ip() {
		local address
		address="$1"
		case " $DNS_QUERY_IPS " in
			*" $address "*) ;;
			*) DNS_QUERY_IPS="${DNS_QUERY_IPS:+$DNS_QUERY_IPS }$address" ;;
		esac
	}

	parse_dns_output() {
		local output_file label ordinal address remainder
		output_file="$1"
		[ -r "$output_file" ] || return

		while read -r label ordinal address remainder; do
			[ "$label" = Address ] || continue
			ordinal=${ordinal%:}
			case "$ordinal" in ""|*[!0-9]*) continue ;; esac
			address=${address%%#*}
			case "$family:$address" in
				ipv4:*[!0-9.]*|ipv4:) continue ;;
				ipv4:*) add_dns_query_ip "$address" ;;
				ipv6:*:*) add_dns_query_ip "$address" ;;
			esac
		done < "$output_file"
	}

	query_dns_upstreams() {
		local domain now output_prefix pids server output_file
		local query_pid timer_pid index
		domain="$1"
		now="$2"
		output_prefix="$TRACK_DIR/DNS_OUTPUT.$$"
		pids=""
		DNS_QUERY_FILES=""
		DNS_QUERY_IPS=""
		index=0

		refresh_dns_upstreams "$now"
		for server in $DNS_UPSTREAMS; do
			index=$((index+1))
			output_file="$output_prefix.$index"
			DNS_QUERY_FILES="${DNS_QUERY_FILES:+$DNS_QUERY_FILES }$output_file"
			WRAP nslookup "$domain" "$server" > "$output_file" 2>/dev/null &
			query_pid=$!
			pids="${pids:+$pids }$query_pid"
		done
		[ -n "$pids" ] || return 1

		(
			sleep "$DNS_RESOLVE_TIMEOUT"
			kill $pids 2>/dev/null
		) &
		timer_pid=$!
		for query_pid in $pids; do
			wait "$query_pid" 2>/dev/null || :
		done
		kill "$timer_pid" 2>/dev/null
		wait "$timer_pid" 2>/dev/null || :

		for output_file in $DNS_QUERY_FILES; do
			parse_dns_output "$output_file"
		done
		cleanup_dns_query_files
		[ -n "$DNS_QUERY_IPS" ]
	}

	dns_cache_get() {
		local _var target now old_ifs record record_target remainder
		local cached_at cached_ips age
		_var="$1"
		target="$2"
		now="$3"
		old_ifs=$IFS
		IFS='
'
		for record in $DNS_CACHE_RECORDS; do
			record_target=${record%%|*}
			[ "$record_target" = "$target" ] || continue
			remainder=${record#*|}
			cached_at=${remainder%%|*}
			cached_ips=${remainder#*|}
			age=$((now-cached_at))
			if [ -n "$cached_ips" ] && [ "$age" -ge 0 ] && [ "$age" -lt "$DNS_CACHE_TTL" ]; then
				IFS=$old_ifs
				export "$_var=$cached_ips"
				return 0
			fi
			break
		done
		IFS=$old_ifs
		export "$_var="
		return 1
	}

	dns_cache_store() {
		local target cached_at cached_ips old_ifs record record_target new_records
		target="$1"
		cached_at="$2"
		cached_ips="$3"
		new_records=""
		old_ifs=$IFS
		IFS='
'
		for record in $DNS_CACHE_RECORDS; do
			record_target=${record%%|*}
			[ "$record_target" = "$target" ] && continue
			new_records="${new_records}${new_records:+
}${record}"
		done
		IFS=$old_ifs
		if [ -n "$cached_ips" ]; then
			new_records="${new_records}${new_records:+
}${target}|${cached_at}|${cached_ips}"
		fi
		DNS_CACHE_RECORDS=$new_records
	}

	write_dns_cache_file() {
		local target cached_at cached_ips cache_key cache_file cache_tmp
		target="$1"
		cached_at="$2"
		cached_ips="$3"
		cache_key=$(printf '%s' "$target" | tr -c 'A-Za-z0-9._-' '_')
		cache_file="$TRACK_DIR/DNS_CACHE_${cache_key}"
		cache_tmp="${cache_file}.tmp.$$"
		{
			printf '%s\n' "$cached_at"
			[ -n "$cached_ips" ] && printf '%s\n' $cached_ips
		} > "$cache_tmp"
		mv -f "$cache_tmp" "$cache_file"
	}

	reset_dns_caches() {
		DNS_CACHE_RECORDS=""
		DNS_UPSTREAMS=""
		DNS_UPSTREAMS_AT=0
		DNS_UPSTREAMS_VALID=0
		DNS_QUERY_IPS=""
		cleanup_dns_query_files
		rm -f "$TRACK_DIR"/DNS_CACHE_* "$TRACK_DIR"/DNS_OUTPUT.*
	}

	resolve_ping_target() {
		local _var target now new_ips
		_var="$1"
		target="$2"

		case "$family:$target" in
			ipv4:*[!0-9.]*) ;;
			ipv4:*) export "$_var=$target"; return 0 ;;
			ipv6:*:*) export "$_var=$target"; return 0 ;;
			ipv6:*) ;;
			*) export "$_var=$target"; return 0 ;;
		esac

		get_uptime now
		if dns_cache_get "$_var" "$target" "$now"; then
			return 0
		fi

		new_ips=""
		if query_dns_upstreams "$target" "$now"; then
			new_ips=$DNS_QUERY_IPS
		fi
		dns_cache_store "$target" "$now" "$new_ips"
		write_dns_cache_file "$target" "$now" "$new_ips"
		export "$_var=$new_ips"
		[ -n "$new_ips" ]
	}

	TRACK_OUTPUT="$TRACK_DIR/TRACK_OUTPUT"
	firstconnect
	while true; do

		sleep_time=$interval

		current_track_ips=
		gateway_ip=
		gateway_resolved=0
		for track_ip in $track_ips; do
			if [ "$track_ip" = "gateway" ]; then
				if [ "$gateway_resolved" -eq 0 ]; then
					get_default_gateway gateway_ip "$family" "$DEVICE"
					gateway_resolved=1
				fi
				current_track_ips="$current_track_ips $gateway_ip"
			else
				current_track_ips="$current_track_ips $track_ip"
			fi
		done

		for track_ip in $current_track_ips; do
			if [ $host_up_count -lt $reliability ]; then
				case "$track_method" in
					ping)
						probe_targets="$track_ip"
						resolve_ping_target probe_targets "$track_ip" || :
						result=1
						loss=100
						latency=999999
						for probe_target in $probe_targets; do
							if [ $check_quality -eq 0 ]; then
								WRAP $PING -n -c $count -W $timeout -s $size -t $max_ttl -q "$probe_target" &> /dev/null &
								wait $!
								result=$?
								[ "$result" -eq 0 ] && break
							else
								WRAP $PING -n -c $count -W $timeout -s $size -t $max_ttl -q "$probe_target" 2>/dev/null > "$TRACK_OUTPUT" &
								wait $!
								ping_status=$?
							ping_quality="$(awk '
								{ line[NR % 2] = $0; n = NR }
								END {
									loss = ""
									latency = ""
									start = n > 1 ? n - 1 : n
									for (i = start; i <= n; i++) {
										s = line[i % 2]
										if (s ~ /% packet loss/) {
											sub(/% packet loss.*$/, "", s)
											sub(/^.*[^0-9]/, "", s)
											loss = s
										}
										s = line[i % 2]
										if (s ~ /(rtt|round-trip).* = /) {
											sub(/^.*(rtt|round-trip).* = [^\/]*\//, "", s)
											sub(/[^0-9].*$/, "", s)
											latency = s
										}
									}
									if (loss == "") loss = 100
									if (latency == "") latency = 999999
									print loss " " latency
								}
							' "$TRACK_OUTPUT")"
							loss=${ping_quality%% *}
							latency=${ping_quality#* }
							[ -n "$loss" ] || loss=100
							[ -n "$latency" ] || latency=999999
								if [ "$ping_status" -ne 0 ] || [ "$loss" -eq 100 ]; then
									latency=999999
									loss=100
								else
									break
								fi
							fi
							done
					;;
					arping)
						WRAP arping -I $DEVICE -c $count -w $timeout -q $track_ip &> /dev/null &
						wait $!
						result=$?
					;;
					httping)
						if [ "$httping_ssl" -eq 1 ]; then
							WRAP httping -c $count -t $timeout -q "https://$track_ip" &> /dev/null &
						else
							WRAP httping -c $count -t $timeout -q "http://$track_ip" &> /dev/null &
						fi
						wait $!
						result=$?
					;;
					nping-*)
						WRAP nping -c $count $track_ip --${track_method#nping-} > "$TRACK_OUTPUT" &
						wait $!
						result=$(awk '/Lost/ {print $12; exit}' "$TRACK_OUTPUT")
						result=${result:-1}
					;;
				esac
				if [ $check_quality -eq 0 ]; then
					if [ $result -eq 0 ]; then
						host_up_count=$((host_up_count+1))
						update_status "$track_ip" "up"

						if [ $score -le $up ]; then
							LOG info "Check ($track_method) success for target \"$track_ip\" on interface $INTERFACE($family) ($DEVICE). Current score: $score"
						fi
					else
						lost=$((lost+1))
						update_status "$track_ip" "down"

						if [ $score -gt $up ]; then
							LOG info "Check ($track_method) failed for target \"$track_ip\" on interface $INTERFACE($family) ($DEVICE). Current score: $score"
						fi
					fi
				else
					if [ "$loss" -ge "$failure_loss" ] || [ "$latency" -ge "$failure_latency" ]; then
						lost=$((lost+1))
						update_status "$track_ip" "down" $latency $loss

						if [ $score -gt $up ]; then
							LOG info "Check (${track_method}: latency=${latency}ms loss=${loss}%) failed for target \"$track_ip\" on interface $INTERFACE($family) ($DEVICE). Current score: $score"
						fi
					elif [ "$loss" -le "$recovery_loss" ] && [ "$latency" -le "$recovery_latency" ]; then
						host_up_count=$((host_up_count+1))
						update_status "$track_ip" "up" $latency $loss

						if [ $score -le $up ]; then
							LOG info "Check (${track_method}: latency=${latency}ms loss=${loss}%) success for target \"$track_ip\" on interface $INTERFACE($family) ($DEVICE). Current score: $score"
						fi
					else
						echo "skipped" > "$TRACK_DIR/TRACK_${track_ip}"
					fi
				fi
			else
				echo "skipped" > "$TRACK_DIR/TRACK_${track_ip}"
			fi
		done

		if [ $host_up_count -lt $reliability ]; then
			score=$((score-1))

			if [ $score -lt $up ]; then
				score=0
				[ ${keep_failure_interval} -eq 1 ] && {
					sleep_time=$failure_interval
				}
			else
				disconnecting
				sleep_time=$failure_interval
			fi

			if [ $score -eq $up ]; then
				disconnected
				score=0
			fi
		else
			if [ $score -lt $((down+up)) ] && [ $lost -gt 0 ]; then
				connecting
				LOG info "Lost $((lost*count)) ping(s) on interface $INTERFACE($family) ($DEVICE). Current score: $score"
			fi

			score=$((score+1))
			lost=0

			if [ $score -gt $up ]; then
				echo "online" > "$TRACK_DIR/STATUS"
				score=$((down+up))
			elif [ $score -le $up ]; then
				connecting
				sleep_time=$recovery_interval
			fi

			if [ $score -eq $up ]; then
				connected
			fi
		fi

		turn=$((turn+1))
		[ -d "$TRACK_DIR" ] || mkdir -p "$TRACK_DIR"
		echo "${lost}" > "$TRACK_DIR/LOST"
		echo "${score}" > "$TRACK_DIR/SCORE"
		echo "${turn}" > "$TRACK_DIR/TURN"
		get_uptime > "$TRACK_DIR/TIME"

		host_up_count=0
		sleep "${sleep_time}" &
		wait $!

		if [ "${IFDOWN_EVENT}" -eq 1 ]; then
			LOG info "Register ifdown event on interface ${INTERFACE}($family) (${DEVICE})"
			reset_dns_caches
			disconnected 1
			IFDOWN_EVENT=0
		elif [ "${IFDOWN_EVENT}" -eq 2 ]; then
			LOG info "Tracker: exit by ifdown event on interface ${INTERFACE}($family) (${DEVICE})"
			disconnected 1
			IFDOWN_EVENT=0
			break
		fi
	done
	reset_dns_caches
	rm -f "$TRACK_OUTPUT"
}

main "$@"
