#!/bin/sh /etc/rc.common
# Copyright (C) 2006-2024 OpenWrt.org

START=98
USE_PROCD=1

PROG="/usr/sbin/urllogger"
QUEUE="/dev/natflow_urllogger_queue"
READER="/usr/sbin/urllogger-reader"
ENABLE="/proc/sys/urllogger_store/enable"

start_service() {
	[ -x "$PROG" ] || return 1
	[ -x "$READER" ] || return 1
	[ -c "$QUEUE" ] || return 1

	procd_open_instance
	procd_set_param command "$PROG" run
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 5
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	[ -w "$ENABLE" ] && printf '0\n' > "$ENABLE"
	return 0
}

service_stopped() {
	[ -c "$QUEUE" ] || return 0
	"$READER" --clear >/dev/null 2>&1
}
