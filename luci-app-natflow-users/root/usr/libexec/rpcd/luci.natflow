#!/usr/bin/env lua

local json = require "luci.jsonc"
local nixio = require "nixio"

local has_ip, luci_ip = pcall(require, "luci.ip")

local USERINFO_CTL = "/dev/natflow_userinfo_ctl"
local USERINFO_READ_SIZE = 4096
local USERINFO_READ_RETRIES = 16

local function parse_hex(value)
	local hex = tostring(value or ""):match("^0[xX]([0-9a-fA-F]+)$")

	if hex then
		return tonumber(hex, 16) or 0
	end

	return tonumber(value) or 0
end

local function normalize_user_ip(ip)
	ip = tostring(ip or "")

	if #ip == 0 or #ip > 45 or ip:find("[^0-9A-Fa-f:.]") then
		return nil
	end

	if has_ip then
		local ip_obj = luci_ip.new(ip)

		if not ip_obj then
			return nil
		end

		return ip_obj:string()
	end

	return ip
end

local function read_userinfo_lines()
	local fd = nixio.open(USERINFO_CTL, nixio.open_flags("rdonly"))
	if not fd then
		return nil
	end

	local lines = {}
	local pending = ""
	local retries = 0

	while retries < USERINFO_READ_RETRIES do
		local data = fd:read(USERINFO_READ_SIZE)

		if not data then
			retries = retries + 1
			if nixio.nanosleep then
				nixio.nanosleep(0, 10000000)
			end
		elseif #data == 0 then
			break
		else
			pending = pending .. data
			retries = 0

			while true do
				local line, rest = pending:match("^([^\n]*)\n(.*)$")

				if not line then
					break
				end

				lines[#lines + 1] = line
				pending = rest
			end
		end
	end

	if pending ~= "" then
		lines[#lines + 1] = pending
	end

	fd:close()
	return lines
end

local function fd_write_all(fd, data)
	if type(fd.writeall) == "function" then
		local ok = fd:writeall(data)
		return ok ~= nil and ok ~= false
	end

	if type(fd.write) ~= "function" then
		return false
	end

	local offset = 1

	while offset <= #data do
		local len = fd:write(data:sub(offset))

		if len == nil or len == false then
			return false
		end

		if len == true then
			return true
		end

		if type(len) ~= "number" or len <= 0 then
			return false
		end

		offset = offset + len
	end

	return true
end

local function write_userinfo_cmd(command)
	local fd = nixio.open(USERINFO_CTL, nixio.open_flags("wronly"))
	if not fd then
		return false
	end

	local ok = fd_write_all(fd, command .. "\n")
	fd:close()

	return ok
end

local function set_user_status(ip, status)
	ip = normalize_user_ip(ip)
	if not ip then
		return { result = "Bad request" }
	end

	if write_userinfo_cmd(string.format("set-status %s %u", ip, status)) then
		return { result = "OK" }
	end

	return { result = "Failed" }, 1
end

local function get_host_hints()
	local mac_to_host = {}
	local ip_to_host = {}

	local lease_files = { "/tmp/dhcp.leases", "/var/dhcp.leases" }
	for _, file in ipairs(lease_files) do
		local f = io.open(file, "r")
		if f then
			for line in f:lines() do
				local ts, mac, ip, name = line:match("^%s*%d+%s+([%a%d:]+)%s+([%d%.%a:]+)%s+([^%s]+)")
				if mac and name and name ~= "*" then
					mac = mac:upper()
					mac_to_host[mac] = name
					if ip then
						ip_to_host[ip] = name
					end
				end
			end
			f:close()
		end
	end

	local host_files = { "/etc/hosts", "/tmp/hosts/dhcp" }
	local nixio_has, nixio = pcall(require, "nixio")
	if nixio_has and nixio.fs and nixio.fs.dir then
		local entries = nixio.fs.dir("/tmp/hosts")
		if entries then
			for entry in entries do
				if entry ~= "." and entry ~= ".." then
					table.insert(host_files, "/tmp/hosts/" .. entry)
				end
			end
		end
	end

	for _, file in ipairs(host_files) do
		local f = io.open(file, "r")
		if f then
			for line in f:lines() do
				line = line:gsub("#.*$", "")
				local ip, name = line:match("^%s*([%d%.%a:]+)%s+([^%s]+)")
				if ip and name and name ~= "*" and name ~= "localhost" and not ip_to_host[ip] then
					ip_to_host[ip] = name
				end
			end
			f:close()
		end
	end

	-- Query umdns browse output via io.popen to handle duplicate JSON keys ("ipv4", "txt") without losing entries
	local p = io.popen("ubus call umdns browse 2>/dev/null")
	if p then
		local cur_item_name = nil
		local cur_host = nil
		local cur_ips = {}
		local cur_macs = {}

		local function flush_cur()
			local name = (cur_item_name and cur_item_name ~= "") and cur_item_name or cur_host
			if name and name ~= "" and name ~= "*" then
				for _, ip in ipairs(cur_ips) do
					if not ip_to_host[ip] then
						ip_to_host[ip] = name
					end
				end
				for _, mac in ipairs(cur_macs) do
					if not mac_to_host[mac] then
						mac_to_host[mac] = name
					end
				end
			end
			cur_item_name = nil
			cur_host = nil
			cur_ips = {}
			cur_macs = {}
		end

		for line in p:lines() do
			local item_key = line:match('^%s*"([^"]+)":%s*{%s*$')
			if item_key then
				if not item_key:find("^_[^%s]+%._[%s%a%d%-]+") and not item_key:find("^_") then
					flush_cur()
					local clean_name = item_key:gsub("^.-@", "")
					cur_item_name = clean_name
				end
			else
				local host_val = line:match('"host":%s*"([^"]+)"')
				if host_val then
					cur_host = host_val:gsub("%.local%.?$", "")
				end

				local ip_val = line:match('"ipv4":%s*"([^"]+)"')
				if ip_val then
					table.insert(cur_ips, ip_val)
				end
				local ip6_val = line:match('"ipv6":%s*"([^"]+)"')
				if ip6_val then
					table.insert(cur_ips, ip6_val)
				end

				local txt_val = line:match('"txt":%s*"([^"]+)"')
				if txt_val then
					local mac = txt_val:match("deviceid=([%a%d:]+)") or txt_val:match("rpBA=([%a%d:]+)")
					if mac then
						table.insert(cur_macs, mac:upper())
					end
				end

				if line:match("^%s*},?%s*$") then
					flush_cur()
				end
			end
		end
		flush_cur()
		p:close()
	end

	return mac_to_host, ip_to_host
end

local methods = {
	get_users = {
		call = function()
			local userinfo = read_userinfo_lines()
			if not userinfo then
				return nil
			end
			local mac_to_host, ip_to_host = get_host_hints()
			local users = { }

			for _, line in ipairs(userinfo) do
				local ip, mac, auth_type, auth_status, rule_id, idle_time, rx_pkts, rx_bytes, tx_pkts, tx_bytes, rx_speed_pkts, rx_speed_bytes, tx_speed_pkts, tx_speed_bytes, ifname =
					line:match("^([^,]+),([^,]+),([^,]+),([^,]+),(%d+),(%d+),(%d+):(%d+),(%d+):(%d+),(%d+):(%d+),(%d+):(%d+),([^,]*)$")

				if not ip then
					ip, mac, auth_type, auth_status, rule_id, idle_time, rx_pkts, rx_bytes, tx_pkts, tx_bytes, rx_speed_pkts, rx_speed_bytes, tx_speed_pkts, tx_speed_bytes =
						line:match("^([^,]+),([^,]+),([^,]+),([^,]+),(%d+),(%d+),(%d+):(%d+),(%d+):(%d+),(%d+):(%d+),(%d+):(%d+)$")
					ifname = ""
				end

				if ip and mac and parse_hex(auth_type) ~= 0 then
					if has_ip and ip:find(":") then
						local ip_obj = luci_ip.new(ip)
						if ip_obj then
							ip = ip_obj:string()
						end
					end

					local mac_upper = mac:upper()
					local hostname = mac_to_host[mac_upper] or ip_to_host[ip] or ""

					local entry = {
						ip = ip,
						mac = mac,
						hostname = hostname,
						auth_type = parse_hex(auth_type),
						status = parse_hex(auth_status),
						rule_id = tonumber(rule_id) or 0,
						idle_time = tonumber(idle_time) or 0,
						rx_pkts = tonumber(rx_pkts) or 0,
						rx_bytes = tonumber(rx_bytes) or 0,
						tx_pkts = tonumber(tx_pkts) or 0,
						tx_bytes = tonumber(tx_bytes) or 0,
						rx_speed_pkts = tonumber(rx_speed_pkts) or 0,
						rx_speed_bytes = tonumber(rx_speed_bytes) or 0,
						tx_speed_pkts = tonumber(tx_speed_pkts) or 0,
						tx_speed_bytes = tonumber(tx_speed_bytes) or 0,
						ifname = ifname or ""
					}
					users[#users + 1] = entry
				end
			end

			return { result = users }
		end
	},
	kick_user = {
		args = { token = "token" },
		call = function(args)
			local ip = normalize_user_ip(args and args.token)
			if not ip then
				return { result = "Bad request" }
			end

			if write_userinfo_cmd(string.format("kick %s", ip)) then
				return { result = "OK" }
			end

			return { result = "Failed" }, 1
		end
	},
	block_user = {
		args = { token = "token" },
		call = function(args)
			return set_user_status(args and args.token, 6)
		end
	},
	allow_user = {
		args = { token = "token" },
		call = function(args)
			return set_user_status(args and args.token, 1)
		end
	}
}

local function parseInput()
	local parse = json.new()
	local done, err

	while true do
		local chunk = io.read(4096)
		if not chunk then
			break
		elseif not done and not err then
			done, err = parse:parse(chunk)
		end
	end

	if not done then
		print(json.stringify({ error = err or "Incomplete input" }))
		os.exit(1)
	end

	return parse:get()
end

local function validateArgs(func, uargs)
	local method = methods[func]
	if not method then
		print(json.stringify({ error = "Method not found" .. func }))
		os.exit(1)
	end

	if type(uargs) ~= "table" then
		print(json.stringify({ error = "Invalid arguments" }))
		os.exit(1)
	end

	uargs.ubus_rpc_session = nil

	local k, v
	local margs = method.args or {}
	for k, v in pairs(uargs) do
		if margs[k] == nil or
		   (v ~= nil and type(v) ~= type(margs[k]))
		then
			print(json.stringify({ error = "Invalid arguments" }))
			os.exit(1)
		end
	end

	return method
end

if arg[1] == "list" then
	local _, method, rv = nil, nil, {}
	for _, method in pairs(methods) do rv[_] = method.args or {} end
	print((json.stringify(rv):gsub(":%[%]", ":{}")))
elseif arg[1] == "call" then
	local args = parseInput()
	local method = validateArgs(arg[2], args)
	local result, code = method.call(args)
	print((json.stringify(result):gsub("^%[%]$", "{}")))
	os.exit(code or 0)

end
