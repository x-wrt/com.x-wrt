{
	"luci-app-natflow-users": {
		"description": "Grant UCI access for luci-app-natflow-users",
		"read": {
			"ubus": {
				"luci.natflow": [ "get_users", "get_mac_users" ],
				"file": [ "stat", "read" ]
			},
			"uci": [ "natflow", "hostacl" ],
			"cgi-io": [ "exec" ],
			"file": {
				"/bin/cat /tmp/url.log": [ "exec" ]
			}
		},
		"write": {
			"ubus": {
				"luci.natflow": [ "block_user", "allow_user" ]
			},
			"uci": [ "natflow", "hostacl" ]
		}
	}
}
