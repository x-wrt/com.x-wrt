#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99

start_service() {
	local enabled protocol
	config_load cloudflare-tunnel
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0
	[ -s /etc/cloudflare-tunnel/tunnel.token ] || return 1
	config_get protocol main protocol auto
	case "$protocol" in auto|http2|quic) ;; *) return 1 ;; esac

	procd_open_instance
	procd_set_param command /usr/bin/cloudflared tunnel --no-autoupdate
	procd_append_param command --protocol "$protocol" --metrics 127.0.0.1:20242
	procd_append_param command run --token-file /etc/cloudflare-tunnel/tunnel.token
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/cloudflare-tunnel/tunnel.token
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger cloudflare-tunnel
	procd_add_interface_trigger 'interface.*.up' wan /etc/init.d/cloudflare-tunnel restart
}
