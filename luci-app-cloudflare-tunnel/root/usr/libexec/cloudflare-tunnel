#!/usr/bin/lua
-- SPDX-License-Identifier: GPL-3.0-only
local json = require "luci.jsonc"
local runtime = require "cloudflare_tunnel.runtime"
local methods = { check = runtime.check, deploy = runtime.foreground, status = runtime.status, stop = runtime.stop, worker = runtime.queued }
local method = methods[arg[1]]
if not method then
	io.stderr:write("Usage: cloudflare-tunnel {check|deploy|status|stop}\n")
	os.exit(1)
end
local result = runtime.safe(method)
print(json.stringify(result))
os.exit(result.error and 1 or 0)
