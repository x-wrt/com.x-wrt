
[ "$ACTION" = "add" ] || [ "$ACTION" = "bind" ] || exit 0
[ "$DEVTYPE" = "usb_interface" ] || exit 0

FIRMWARE=
INTERFACE="/sys$DEVPATH"
logger -t p910nd-helper "Loading device[$PRODUCT] path[$DEVPATH]"

case "$PRODUCT" in
	#HP LaserJet 1000
	"3f0/517/120")
	FIRMWARE=/usr/share/p910nd/firmware/sihp1000.dl
	;;

	#HP LaserJet 1005/M1005
	"3f0/3b17/100"|\
	"3f0/1317/120")
	FIRMWARE=/usr/share/p910nd/firmware/sihp1005.dl
	;;

	#HP LaserJet 1018
	"3f0/4117/100")
	FIRMWARE=/usr/share/p910nd/firmware/sihp1018.dl
	;;

	#HP LaserJet 1020
	"3f0/3017/100"|\
	"3f0/2d17/100"|\
	"3f0/2c17/100"|\
	"3f0/2b17/100")
	FIRMWARE=/usr/share/p910nd/firmware/sihp1020.dl
	;;

	#HP LaserJet P1005
	"3f0/3d17/100")
	FIRMWARE=/usr/share/p910nd/firmware/sihpP1005.dl
	;;

	#HP LaserJet P1006
	"3f0/3e17/100")
	FIRMWARE=/usr/share/p910nd/firmware/sihpP1006.dl
	;;

	#HP LaserJet P1007
	"3f0/4817/100")
	FIRMWARE=/usr/share/p910nd/firmware/sihpP1007.dl
	;;

	#HP LaserJet P1008
	"3f0/4917/100")
	FIRMWARE=/usr/share/p910nd/firmware/sihpP1008.dl
	;;

	#HP LaserJet P1505
	"3f0/4017/100"|\
	"3f0/3f17/100")
	FIRMWARE=/usr/share/p910nd/firmware/sihpP1505.dl
	;;
	*)
	logger -t p910nd-helper "No firmware support for device[$PRODUCT]"
	;;
esac

test -e "$FIRMWARE" || exit 0
[ -n "$DEVPATH" ] || exit 0
read -r INTERFACE_CLASS < "$INTERFACE/bInterfaceClass" || exit 0
[ "$INTERFACE_CLASS" = "07" ] || exit 0

(
	mkdir -p /var/run
	lock /var/run/p910nd-helper.lck || exit 1

	for attempt in $(seq 30); do
		grep -Fqx "PRODUCT=$PRODUCT" "$INTERFACE/uevent" 2>/dev/null || break
		DEVICE=
		for PRINTER in "$INTERFACE"/usbmisc/lp*; do
			[ -e "$PRINTER" ] || continue
			DEVICE="/dev/usb/${PRINTER##*/}"
			break
		done

		if [ -n "$DEVICE" ] && [ -c "$DEVICE" ] && (
			# Keep the device open so a recycled lpN cannot receive this upload.
			exec 3<> "$DEVICE" || exit 1
			[ "$(readlink -f "/sys/class/usbmisc/${DEVICE##*/}/device")" = "$INTERFACE" ] || exit 1
			grep -Fqx "PRODUCT=$PRODUCT" "$INTERFACE/uevent" 2>/dev/null || exit 1
			DEVICE_ID=$(usb_printerid - <&3 2>/dev/null) || exit 1
			if printf '%s\n' "$DEVICE_ID" | grep -q FWVER; then
				logger -t p910nd-helper "Firmware already there on $DEVICE[$PRODUCT]"
				exit 0
			fi
			logger -t p910nd-helper "No Firmware found on $DEVICE[$PRODUCT], sending..."
			if cat "$FIRMWARE" >&3; then
				logger -t p910nd-helper "Done. Firmware download to $DEVICE[$PRODUCT]"
				exit 0
			fi
			logger -t p910nd-helper "Firmware download failed on $DEVICE[$PRODUCT]"
			exit 1
		); then
			break
		fi
		logger -t p910nd-helper "Device $DEVICE[$PRODUCT] not ready (attempt $attempt/30)..."
		sleep 1
	done
	sleep 15
	lock -u /var/run/p910nd-helper.lck
) &
