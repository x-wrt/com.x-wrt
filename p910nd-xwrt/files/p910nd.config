config p910nd
	option device        /dev/usb/lp0
	# Actual TCP port is 9100 plus this value
	# Valid values are 0-9
	option port          0
	option bidirectional 1
	option enabled       0
	# Override running as user p910nd, group lp
	option runas_root    0

	# mDNS support - see Bonjour Printing Specification for details concerning the values
	# Each enabled printer advertises its own service instance. Requires running umdns.
	# Set to 1 to enable
	option mdns          0
	# Optional unique service name; defaults to "<model> @ <hostname> (<TCP port>)".
	# Use 1-63 UTF-8 bytes without controls, dots or backslashes (umdns limitation).
	# Invalid or duplicate names fall back to an automatically generated name.
	option mdns_name     ''
	# Human-readable printer make and model
	option mdns_ty       'My Printer Manufacturer/Model'
	# Human-readable location
	option mdns_note     'Basement'
	# Post-Script product string, including parenthesis
	option mdns_product  ''
	# IEEE-1284 Device ID MANUFACTURER/MFG string
	option mdns_mfg      ''
	# IEEE-1284 Device ID MODEL/MDL string
	option mdns_mdl      ''
	# IEEE-1284 Device ID COMMAND SET/CMD string
	option mdns_cmd      ''
